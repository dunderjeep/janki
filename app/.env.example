# The Next.js app's settings: copy to app/.env.local (never commit it).
# Only the first block is required; everything else turns a feature on.

# ── Required ───────────────────────────────────────────────────────────────
# Must match .env at the repo root.
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/janki
# Session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Object storage (the MinIO from docker compose).
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-too

# ── Sign-in ────────────────────────────────────────────────────────────────
# Bluesky sign-in (with an app password) works with no setup. Google sign-in
# needs an OAuth client from console.cloud.google.com, with the redirect URI
# <your origin>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public origin, when janki is reached through a proxy or tunnel.
# AUTH_URL=https://my-host.example:8443

# ── Claude (card drafting, cover letters, explanations) ────────────────────
# Named so it doesn't clash with an ANTHROPIC_API_KEY your shell may hold.
JANKI_ANTHROPIC_KEY=

# ── Mail ───────────────────────────────────────────────────────────────────
# Encrypts stored mailbox passwords. Generate with: openssl rand -hex 32
# (changing it later means entering mailbox passwords again)
MAIL_SECRET_KEY=
# MAIL_SYNC=off            # stop the 15-minute background sync

# ── Bokki (Norwegian sole-trader bookkeeping) ──────────────────────────────
# BOKKI_BUSINESS_NAME="My Bakery"
# BOKKI_LEGAL_NAME="Your Name"
# BOKKI_ORG_NUMBER="999 999 999"

# ── Joblowski ──────────────────────────────────────────────────────────────
# JOBLOWSKI_ALERTS=off     # stop the background job-alert checks
# CHROME_PATH=/usr/bin/google-chrome   # for résumé PDF export

# ── Optional extras ────────────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=   # place search in the graph
# NOTES_ORG_DIR=~/org                  # mirror notes out to .org files
# NOTES_ORG_DID=did:plc:…              # whose notes get mirrored
# JANKI_EXTRA_APPS=[{"href":"/my-app","title":"My app","subtitle":"…","glyph":"★","tile":"from-sky-400 to-sky-700"}]
