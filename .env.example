# Docker Compose settings: copy to .env (never commit .env).

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=janki
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# ── MinIO (S3-compatible storage for photos, receipts, attachments) ────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-too
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# ── pgAdmin (optional: docker compose --profile tools up -d pgadmin) ──────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5051
